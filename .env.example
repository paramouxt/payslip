# ── Database (Supabase Postgres) ──────────────────────────────────────────
# Pooled connection (PgBouncer) for the application:
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection for migrations (prisma migrate deploy):
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ── Tests ─────────────────────────────────────────────────────────────────
# Integration tests run only when this is set (a disposable database!):
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payslip_test"

# ── Application secrets (introduced in later phases) ──────────────────────
# AUTH_SECRET=            # Auth.js session encryption (Phase 6)
# AUTH_GOOGLE_ID=         # Google OAuth client — basic scopes only (Phase 6)
# AUTH_GOOGLE_SECRET=
# APP_ENCRYPTION_KEY=     # 32-byte base64 key for field-level AES-256-GCM (Phase 7)
# CRON_SECRET=            # shared secret for /api/cron/daily (Phase 7)
# SUPABASE_URL=           # Storage + Realtime (Phase 7)
# SUPABASE_SERVICE_ROLE_KEY=
